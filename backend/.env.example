# Required for Ask Orbit's real-time conversation. Create this as .env locally
# or add the value in your hosting provider's backend environment settings.
GEMINI_API_KEY=replace_with_your_Gemini_API_key

# Optional. Set this only if your Gemini account uses a different model.
ORBIT_AI_MODEL=gemini-2.5-flash

# Required by the existing database setup.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
TOKEN_SECRET=replace_with_a_long_random_secret

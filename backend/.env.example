# Required for Ask Orbit's real-time conversation. Create this as .env locally
# or add the value in your hosting provider's backend environment settings.
GEMINI_API_KEY=replace_with_your_Gemini_API_key

# Optional. Set this only if your Gemini account uses a different model.
ORBIT_AI_MODEL=gemini-2.5-flash

# Required by the existing database setup.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
TOKEN_SECRET=replace_with_a_long_random_secret

# Required for password-reset emails in production. Use a verified sender.
FRONTEND_URL=https://ai-daily-planer.vercel.app
RESEND_API_KEY=replace_with_your_Resend_API_key
RESEND_FROM=Orbitday <support@your-verified-domain.com>

# Alternatively, use an SMTP provider instead of Resend.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=Orbitday <support@your-verified-domain.com>
# SMTP_USERNAME=your_username
# SMTP_PASSWORD=your_password
